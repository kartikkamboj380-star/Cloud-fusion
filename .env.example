# ── CloudFusion environment — copy to .env and fill. NEVER commit real .env ──

# PostgreSQL connection (required)
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db

# Public base URL of THIS deployment (used for OAuth redirect URIs)
APP_BASE_URL=http://localhost:3000

# HMAC secret for session cookies (generate: openssl rand -hex 32)
APP_SECRET=

# AES-256-GCM key source for OAuth token encryption at rest (openssl rand -hex 32)
TOKEN_ENCRYPTION_KEY=

# Google OAuth 2.0 (Google Cloud Console → APIs & Services → Credentials)
# Required OAuth scope: https://www.googleapis.com/auth/drive.file
# Authorized redirect URI must be: {APP_BASE_URL}/api/auth/google/callback
# When these are absent, CloudFusion runs in clearly-labeled DEMO MODE
# (virtual throughput, no real Google writes).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Force demo mode even when OAuth creds exist (true/false)
DEMO_MODE=
